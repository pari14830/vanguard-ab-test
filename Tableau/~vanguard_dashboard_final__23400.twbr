    <worksheet name='kpi_target_gap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='16'>Target Gap</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vanguard_tableau_final' name='federated.083a1ru1jlaz50107j2971vpp9qb' />
          </datasources>
          <datasource-dependencies datasource='federated.083a1ru1jlaz50107j2971vpp9qb'>
            <column caption='Completion Lift (pp)' datatype='real' name='[Calculation_2431903045349376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 * (&#13;&#10;    COUNTD(IF [Variation] = &quot;Test&quot; AND [process_step] = &quot;confirm&quot;&#13;&#10;        THEN [client_id] END)&#13;&#10;    /&#13;&#10;    COUNTD(IF [Variation] = &quot;Test&quot; THEN [client_id] END)&#13;&#10;&#13;&#10;    -&#13;&#10;&#13;&#10;    COUNTD(IF [Variation] = &quot;Control&quot; AND [process_step] = &quot;confirm&quot;&#13;&#10;        THEN [client_id] END)&#13;&#10;    /&#13;&#10;    COUNTD(IF [Variation] = &quot;Control&quot; THEN [client_id] END)&#13;&#10;)' />
            </column>
            <column caption='Target Gap (pp)' datatype='real' name='[Calculation_2431903046131713]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2431903045349376] - 5' />
            </column>
            <column caption='Target Status' datatype='string' name='[Calculation_2431903335120899]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2431903046131713] &gt;= 0 THEN&#13;&#10;    &quot;Target Met&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Target Not Met&quot;&#13;&#10;END' />
            </column>
            <column aggregation='None' caption='Tenure(years)' datatype='integer' name='[Clnt Tenure Yr (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[clnt_tenure_yr]' peg='0' size='5' />
              <aliases>
                <alias key='0' value='0-4' />
                <alias key='1' value='5 -9' />
                <alias key='2' value='10 - 14' />
                <alias key='3' value='15 -19' />
                <alias key='4' value=' 20-24' />
                <alias key='5' value='25-29' />
                <alias key='6' value='30-34' />
                <alias key='7' value=' 35-39' />
                <alias key='8' value=' 40-44' />
                <alias key='9' value='45 -49' />
                <alias key='10' value='50-54' />
                <alias key='11' value='55-59' />
              </aliases>
            </column>
            <column datatype='string' name='[Variation]' role='dimension' type='nominal' />
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;35-49&quot;' value='35 - 49' />
                <alias key='&quot;50-64&quot;' value='50 - 64' />
                <alias key='&quot;65+&quot;' value='65 +' />
              </aliases>
            </column>
            <column caption='Client Id' datatype='integer' name='[client_id]' role='dimension' type='ordinal' />
            <column caption='Clnt Tenure Yr' datatype='real' name='[clnt_tenure_yr]' role='dimension' type='quantitative' />
            <column caption='Gendr' datatype='string' name='[gendr]' role='dimension' type='nominal' />
            <column-instance column='[Clnt Tenure Yr (bin)]' derivation='None' name='[none:Clnt Tenure Yr (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[age_group]' derivation='None' name='[none:age_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[gendr]' derivation='None' name='[none:gendr:nk]' pivot='key' type='nominal' />
            <column caption='Process Step' datatype='string' name='[process_step]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;step_1&quot;' value='step 1' />
                <alias key='&quot;step_2&quot;' value='step 2' />
                <alias key='&quot;step_3&quot;' value='step 3' />
              </aliases>
            </column>
            <column-instance column='[Calculation_2431903046131713]' derivation='User' name='[usr:Calculation_2431903046131713:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2431903335120899]' derivation='User' name='[usr:Calculation_2431903335120899:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.083a1ru1jlaz50107j2971vpp9qb].[none:Clnt Tenure Yr (bin):ok]' filter-group='5'>
            <groupfilter function='level-members' level='[none:Clnt Tenure Yr (bin):ok]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.083a1ru1jlaz50107j2971vpp9qb].[none:age_group:nk]' filter-group='3'>
            <groupfilter function='level-members' level='[none:age_group:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
