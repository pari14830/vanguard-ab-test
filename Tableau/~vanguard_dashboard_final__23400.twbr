    <worksheet name='avg_time_per_step'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='10'>Average Time per Step</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='vanguard_tableau_final' name='federated.083a1ru1jlaz50107j2971vpp9qb' />
          </datasources>
          <datasource-dependencies datasource='federated.083a1ru1jlaz50107j2971vpp9qb'>
            <column caption='Valid Step Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1705674936844291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [time_spent_sec] &gt;= 0&#13;&#10;AND [time_spent_sec] &lt;= 1800&#13;&#10;AND [process_step] != &quot;confirm&quot;&#13;&#10;THEN [time_spent_sec]&#13;&#10;END' />
