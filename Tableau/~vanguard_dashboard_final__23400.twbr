            <column-instance column='[Calculation_2431903341359110]' derivation='User' name='[usr:Calculation_2431903341359110:qk]' pivot='key' type='quantitative' />
            <column caption='Visit Id' datatype='string' name='[visit_id]' role='dimension' type='nominal' />
