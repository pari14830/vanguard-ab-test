      <aliases enabled='yes' />
      <column caption='% Clients Reaching Step' datatype='real' default-format='p0.0%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([client_id]) / TOTAL(COUNTD([client_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Error Rate' datatype='real' default-format='p0.00%' name='[Calculation_1042669425430528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_error]) / COUNT([visit_id])' />
      </column>
      <column caption='Age Range' datatype='string' name='[Calculation_1705674927218690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT([clnt_age] / 5) * 5)&#13;&#10;+ &quot;–&quot; +&#13;&#10;STR(INT([clnt_age] / 5) * 5 + 4)' />
      </column>
      <column caption='Valid Step Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1705674936844291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [time_spent_sec] &gt;= 0&#13;&#10;AND [time_spent_sec] &lt;= 1800&#13;&#10;AND [process_step] != &quot;confirm&quot;&#13;&#10;THEN [time_spent_sec]&#13;&#10;END' />
      </column>
      <column caption='Completion Rate' datatype='real' default-format='p0.0%' name='[Calculation_2132560290516992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [process_step] = &quot;confirm&quot; THEN [client_id] END) / COUNTD([client_id])' />
      </column>
      <column caption='Completion Lift (pp)' datatype='real' name='[Calculation_2431903045349376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (&#13;&#10;    COUNTD(IF [Variation] = &quot;Test&quot; AND [process_step] = &quot;confirm&quot;&#13;&#10;        THEN [client_id] END)&#13;&#10;    /&#13;&#10;    COUNTD(IF [Variation] = &quot;Test&quot; THEN [client_id] END)&#13;&#10;&#13;&#10;    -&#13;&#10;&#13;&#10;    COUNTD(IF [Variation] = &quot;Control&quot; AND [process_step] = &quot;confirm&quot;&#13;&#10;        THEN [client_id] END)&#13;&#10;    /&#13;&#10;    COUNTD(IF [Variation] = &quot;Control&quot; THEN [client_id] END)&#13;&#10;)' />
      </column>
      <column caption='Target Gap (pp)' datatype='real' name='[Calculation_2431903046131713]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2431903045349376] - 5' />
      </column>
      <column caption='Dynamic Target' datatype='real' default-format='p0.0%' name='[Calculation_2431903320821762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Variation] = &quot;Control&quot;&#13;&#10;    AND [process_step] = &quot;confirm&quot;&#13;&#10;    THEN [client_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [Variation] = &quot;Control&quot;&#13;&#10;    THEN [client_id]&#13;&#10;    END&#13;&#10;)&#13;&#10;+ 0.05' />
      </column>
      <column caption='Target Status' datatype='string' name='[Calculation_2431903335120899]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2431903046131713] &gt;= 0 THEN&#13;&#10;    &quot;Target Met&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Target Not Met&quot;&#13;&#10;END' />
      </column>
      <column caption='Control Completion Rate' datatype='real' default-format='p0.00%' name='[Calculation_2431903338414084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Variation] = &quot;Control&quot;&#13;&#10;    AND [process_step] = &quot;confirm&quot;&#13;&#10;    THEN [client_id] END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF [Variation] = &quot;Control&quot;&#13;&#10;    THEN [client_id] END&#13;&#10;)' />
      </column>
      <column caption='Control Error Rate' datatype='real' default-format='p0.00%' name='[Calculation_2431903339913221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Variation] = &quot;Control&quot; THEN [is_error] END)&#13;&#10;/&#13;&#10;COUNT(IF [Variation] = &quot;Control&quot; THEN [visit_id] END)' />
      </column>
